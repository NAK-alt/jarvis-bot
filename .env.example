# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# Security: Lock bot to your Telegram ID (comma-separated if multiple)
ALLOWED_USER_IDS=

# Voice Settings (Microsoft Edge-TTS)
VOICE_NAME=en-GB-RyanNeural
VOICE_REPLY_ENABLED=true

# Railway 24/7 Cloud & PC Bridge Settings
PORT=8080
BRIDGE_SECRET_KEY=jarvis-secret-key-change-me
# On your local PC, set this to your Railway app WebSocket URL:
RAILWAY_URL=wss://your-app-name.up.railway.app/ws
